node {
    // ─── CONFIG ───────────────────────────────────────────────
    def AWS_REGION       = 'ap-south-1'
    def AWS_ACCOUNT_ID   = '624858524005'
    def ECR_REPO_NAME    = 'sample-app'
    def IMAGE_TAG        = "${env.BUILD_NUMBER}"
    def ECR_REGISTRY     = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    def IMAGE_FULL       = "${ECR_REGISTRY}/${ECR_REPO_NAME}:${IMAGE_TAG}"

    def ARGOCD_SERVER    = 'a1bcd79c106cc44d08125105419242e4-338524828.ap-south-1.elb.amazonaws.com'
    def APP_NAME         = 'kubernates-demo'
    def REPO_URL         = 'https://github.com/sesu808/kubernates-demo'
    def HELM_PATH        = 'helm'
    def DEST_NAMESPACE   = 'production'
    def DEST_SERVER      = 'https://kubernetes.default.svc'
    def REVISION         = 'main'
    // ──────────────────────────────────────────────────────────

    stage('Checkout') {
        checkout scm
    }

    stage('Build Docker Image') {
        sh "docker build -t ${IMAGE_FULL} ."
    }

    stage('Push to AWS ECR') {
        withCredentials([
            string(credentialsId: 'aws-access-key-id',     variable: 'AWS_ACCESS_KEY_ID'),
            string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY')
        ]) {
            sh """
                export AWS_ACCESS_KEY_ID=\$AWS_ACCESS_KEY_ID
                export AWS_SECRET_ACCESS_KEY=\$AWS_SECRET_ACCESS_KEY
                export AWS_DEFAULT_REGION=${AWS_REGION}

                aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin ${ECR_REGISTRY}

                aws ecr describe-repositories --repository-names ${ECR_REPO_NAME} \
                    --region ${AWS_REGION} || \
                aws ecr create-repository --repository-name ${ECR_REPO_NAME} \
                    --region ${AWS_REGION}

                docker push ${IMAGE_FULL}
            """
        }
    }

    stage('Create Namespace (if not exists)') {
        sh """
            kubectl get namespace ${DEST_NAMESPACE} || kubectl create namespace ${DEST_NAMESPACE}
        """
    }

    stage('ArgoCD - Create & Sync App') {
        withCredentials([string(credentialsId: 'argocd-token', variable: 'ARGOCD_AUTH_TOKEN')]) {
            sh """
                argocd login ${ARGOCD_SERVER}:443 \
                    --auth-token \$ARGOCD_AUTH_TOKEN \
                    --grpc-web \
                    --insecure

                argocd app create ${APP_NAME} \
                    --repo ${REPO_URL} \
                    --path ${HELM_PATH} \
                    --dest-server ${DEST_SERVER} \
                    --dest-namespace ${DEST_NAMESPACE} \
                    --revision ${REVISION} \
                    --helm-set image.repository=${ECR_REGISTRY}/${ECR_REPO_NAME} \
                    --helm-set image.tag=${IMAGE_TAG} \
                    --sync-policy automated \
                    --auto-prune \
                    --self-heal \
                    --upsert

                argocd app sync ${APP_NAME} --grpc-web
                argocd app wait ${APP_NAME} \
                    --health \
                    --timeout 180 \
                    --grpc-web
            """
        }
    }

    stage('Verify Deployment') {
        withCredentials([string(credentialsId: 'argocd-token', variable: 'ARGOCD_AUTH_TOKEN')]) {
            sh """
                argocd app get ${APP_NAME} --grpc-web
            """
        }
    }

    stage('Cleanup') {
        sh "docker rmi ${IMAGE_FULL} || true"
    }
}